# Copy to backend/.env and fill in ONE of the API keys.
# Without any key the app runs in demo mode (no real hair change).

# gemini | openai | demo  (leave empty to auto-pick from the keys below)
PROVIDER=

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-1
# "high" keeps the face closer to the selfie; leave empty for models that don't support it
OPENAI_INPUT_FIDELITY=high
# low | medium | high
OPENAI_QUALITY=medium

MAX_UPLOAD_MB=10
